# Môi trường chạy ứng dụng
APP_ENV=development

# Cấu hình LLM chính: "groq" (khuyên dùng, tốc độ cao) hoặc "openrouter"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter (dự phòng)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Qdrant (mặc định dùng storage cục bộ tại data/indexes/qdrant_db)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/indexes/qdrant_db
QDRANT_COLLECTION=law_chunks

# Embedding và tìm kiếm
EMBEDDING_MODEL=BAAI/bge-m3
RETRIEVAL_TOP_K=8
CONTEXT_TOP_K=5

# Thông tin ứng dụng
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=VN Legal RAG Assistant
